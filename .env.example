# .env.example - contains NO real credentials.
# Copy to .env (which is git-ignored) and fill in your own values.

# Which LLM provider the agent uses: claude | ollama | mock
#   claude - Anthropic Messages API (needs ANTHROPIC_API_KEY)
#   ollama - local model through Ollama (free, offline)
#   mock   - scripted offline stand-in for tests and demos without a key
LLM_PROVIDER=claude

# Anthropic API key (only for LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Main planning model and the cheaper model used for FAQ answers and invitations
LLM_MODEL=claude-sonnet-5-5
LLM_LIGHT_MODEL=claude-haiku-5-5

# Ollama settings (only for LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Where the SQLite database and the e-mail outbox are stored
EVENTPILOT_DATA_DIR=data
