@startuml SD10_modify_undo_cli
!include style.iuml
hide footbox
autonumber "<b>[0]"
title SD10 — Change the plan in plain language, then undo — from the CLI (F12, UC12, UC14)\n<size:13><i>Shows that the command-line interface uses exactly the same facade as the GUI.</i></size>

actor Organizer
box "CLI" #EEF5FD
  participant ":AgendaCliCommand" as CLI
  participant ":ConsoleProposal\nReviewer" as CR
end box
box "Application" #FFF8F0
  participant ":EventPlannerFacade" as F
  participant ":CommandHistory" as CH
end box
box "Agent" #FFFDE7
  participant ":PlanModification\nWorkflow" as WF
  participant ":CommandMapper" as CM
end box
box "Domain" #FBF7FF
  participant "event:Event" as EV
end box

== Change the plan ==
Organizer -> CLI : eventpilot agenda modify --event E1\n"move the keynote to 2pm and add a 15-min break after it"
CLI -> F : modifyPlan(eventId, instruction)
activate F
F -> WF : execute(event, instruction)
activate WF
note right of WF : the prompt contains the agenda with item ids;\nconversation memory resolves words like "it"
WF -> WF : agent loop → list of operations (JSON)
loop each operation
  WF -> CM : toCommand(op)
  CM --> WF : MoveSessionCommand / AddAgendaItemCommand
end
WF --> F : PlanProposal
deactivate WF
F --> CLI : PlanProposal
deactivate F
alt the instruction is ambiguous (two "keynote" sessions)
  CLI -> Organizer : "Which keynote: Opening or AI?"
else
  CLI -> CR : review(proposal)
  CR -> Organizer : prints 2 changes — "Apply? [y/N]"
  Organizer -> CR : y
  CR --> CLI : APPROVE_ALL
  CLI -> F : applyProposal(eventId, proposal)
  F -> CH : execute(event, macroCommand)
  CH -> EV : move keynote, add break
  F -> F : save, publish(AGENDA_CHANGED)
end

== Undo ==
Organizer -> CLI : eventpilot agenda undo --event E1
CLI -> F : undo(eventId)
activate F
F -> CH : undo(event)
alt nothing to undo
  CH --> F : none → "Nothing to undo"
else
  CH -> EV : macroCommand.undo(event)\n(steps reversed: remove break, restore keynote time)
  F -> F : save, publish(AGENDA_CHANGED)
  F --> CLI : event → "Undid: move keynote, add break"
end
deactivate F
@enduml
