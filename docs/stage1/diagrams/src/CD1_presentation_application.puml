@startuml CD1_presentation_application
!include style.iuml
hide empty members
left to right direction
title CD1 — Presentation (GUI + CLI) and Application Layer\n<size:13><i>Both front-ends call the same EventPlannerFacade. Every change to an event is an EventCommand; every change is announced on the EventBus.</i></size>

package "GUI — JavaFX views (MVC: View)" #EEF5FD {
  abstract class BaseView <<Observer>> {
    + onEventChanged(d : DomainEvent) : void
    + {abstract} refresh(e : Event) : void
  }
  class DashboardView
  class AgendaView
  class AttendeeView
  class VenueView
  class BudgetView
  class TaskBoardView
  class ChatPanel {
    + appendMessage(m : Message) : void
    + showThinking(on : boolean) : void
  }
  class ProposalReviewDialog {
    + show(p : PlanProposal) : ReviewDecision
  }
  BaseView <|-- DashboardView
  BaseView <|-- AgendaView
  BaseView <|-- AttendeeView
  BaseView <|-- VenueView
  BaseView <|-- BudgetView
  BaseView <|-- TaskBoardView
}

package "GUI — controllers (MVC: Controller)" #EEF5FD {
  abstract class BaseController {
    # facade : EventPlannerFacade
    # reviewer : ProposalReviewer
    # runAsync(task : Callable<T>, onDone : Consumer<T>) : void
    # reviewAndApply(eventId : UUID, p : PlanProposal) : void
  }
  class AgentChatController {
    + submitMessage(text : String) : void
    + handleClarification(answer : String) : void
    + onAskFaq(question : String) : void
  }
  class EventController {
    + onRecommendVenues() : void
    + onTransition(a : LifecycleAction) : void
  }
  class AgendaController {
    + onGenerateAgenda(p : AgendaPreferences) : void
    + onScheduleSpeakers() : void
    + onDetectConflicts() : void
    + onResolveConflicts() : void
    + onModifyPlan(instruction : String) : void
    + onUndo() : void
    + onRedo() : void
  }
  class AttendeeController {
    + onAddAttendee(f : AttendeeForm) : void
    + onImportCsv(csv : Path) : void
    + onUpdateRsvp(id : UUID, s : RsvpStatus) : void
    + onPlanCatering() : void
    + onDraftInvitations(t : Tone) : void
    + onSendInvitations(inv : List<Invitation>) : void
  }
  class BudgetController {
    + onGenerateBudget() : void
    + onRecordExpense(f : ExpenseForm) : void
  }
  class TaskController {
    + onGenerateTasks() : void
    + onUpdateTaskStatus(id : UUID, s : TaskStatus) : void
  }
  class GuiProposalReviewer {
    + review(p : PlanProposal) : ReviewDecision
  }
  BaseController <|-- AgentChatController
  BaseController <|-- EventController
  BaseController <|-- AgendaController
  BaseController <|-- AttendeeController
  BaseController <|-- BudgetController
  BaseController <|-- TaskController
}

package "CLI — picocli" #EEF5FD {
  class EventPilotCli {
    + {static} main(args : String[]) : void
  }
  abstract class BaseCliCommand {
    # facade : EventPlannerFacade
    # reviewer : ProposalReviewer
    + {abstract} call() : Integer
  }
  class "EventCliCommand\nAttendeeCliCommand\nVenueCliCommand\nAgendaCliCommand\nBudgetCliCommand\nCateringCliCommand\nTaskCliCommand\nInviteCliCommand\nAskCliCommand\nChatCliCommand" as CliCmds <<10 subcommands>>
  class ConsoleProposalReviewer {
    + review(p : PlanProposal) : ReviewDecision
  }
  class ConsolePrinter {
    + printProposal(p : PlanProposal) : void
    + printEvent(e : Event) : void
    + printError(msg : String) : void
  }
  EventPilotCli *--> "10" BaseCliCommand
  BaseCliCommand <|-- CliCmds
  BaseCliCommand --> ConsolePrinter
}

package "Application layer" #FFF8F0 {
  class EventPlannerFacade <<Facade>> {
    + createEventFromDescription(text : String, sessionId : String) : AgentResponse
    + answerClarification(sessionId : String, answer : String) : AgentResponse
    + transitionEvent(eventId : UUID, a : LifecycleAction) : EventState
    + addAttendee(eventId : UUID, f : AttendeeForm) : Attendee
    + importAttendees(eventId : UUID, csv : Path) : ImportReport
    + updateRsvp(eventId : UUID, attendeeId : UUID, s : RsvpStatus) : void
    + recommendVenues(eventId : UUID) : PlanProposal
    + generateAgenda(eventId : UUID, p : AgendaPreferences) : PlanProposal
    + scheduleSpeakers(eventId : UUID) : PlanProposal
    + detectConflicts(eventId : UUID) : List<Conflict>
    + resolveConflicts(eventId : UUID, cs : List<Conflict>) : PlanProposal
    + generateBudget(eventId : UUID) : PlanProposal
    + recordExpense(eventId : UUID, x : Expense) : BudgetStatus
    + planCatering(eventId : UUID) : PlanProposal
    + generateTasks(eventId : UUID) : PlanProposal
    + updateTaskStatus(eventId : UUID, taskId : UUID, s : TaskStatus) : void
    + draftInvitations(eventId : UUID, t : Tone) : List<Invitation>
    + sendInvitations(eventId : UUID, inv : List<Invitation>) : DeliveryReport
    + askFaq(eventId : UUID, question : String) : FaqAnswer
    + modifyPlan(eventId : UUID, instruction : String) : PlanProposal
    + applyProposal(eventId : UUID, p : PlanProposal) : Event
    + undo(eventId : UUID) : Event
    + redo(eventId : UUID) : Event
  }
  interface ProposalReviewer {
    + review(p : PlanProposal) : ReviewDecision
  }

  interface EventCommand <<Command>> {
    + execute(e : Event) : void
    + undo(e : Event) : void
    + describe() : String
  }
  class CommandHistory <<Invoker>> {
    - undoStack : Deque<EventCommand>
    - redoStack : Deque<EventCommand>
    + execute(e : Event, c : EventCommand) : void
    + undo(e : Event) : EventCommand
    + redo(e : Event) : EventCommand
  }
  class MacroCommand <<Command>> {
    - children : List<EventCommand>
    + execute(e : Event) : void
    + undo(e : Event) : void
  }
  class "AddAgendaItemCommand\nRemoveAgendaItemCommand\nMoveSessionCommand\nAssignSpeakerCommand\nSetVenueCommand\nSetBudgetLineCommand\nSetCateringPlanCommand\nAddTaskCommand" as Cmds <<Command>>
  EventCommand <|.. MacroCommand
  EventCommand <|.. Cmds
  MacroCommand o--> "1..*" EventCommand
  CommandHistory o--> "0..*" EventCommand

  class EventBus <<Subject>> {
    + subscribe(o : EventObserver) : void
    + publish(d : DomainEvent) : void
  }
  interface EventObserver <<Observer>> {
    + onEventChanged(d : DomainEvent) : void
  }
  class AlertService <<Observer>> {
    + onEventChanged(d : DomainEvent) : void
    + checkOverdueTasks(today : LocalDate) : List<Alert>
    + getActiveAlerts(eventId : UUID) : List<Alert>
  }
  class KnowledgeBaseIndexer <<Observer>> {
    + onEventChanged(d : DomainEvent) : void
  }
  EventBus o--> "0..*" EventObserver : notifies
  EventObserver <|.. AlertService
  EventObserver <|.. KnowledgeBaseIndexer

  EventPlannerFacade --> CommandHistory
  EventPlannerFacade --> EventBus
}

BaseView ..|> EventObserver
BaseController --> EventPlannerFacade
BaseCliCommand --> EventPlannerFacade
BaseController --> ProposalReviewer
BaseCliCommand --> ProposalReviewer
GuiProposalReviewer ..|> ProposalReviewer
ConsoleProposalReviewer ..|> ProposalReviewer
GuiProposalReviewer --> ProposalReviewDialog
ChatPanel ..> AgentChatController : user input

legend right
  <b>Colour = pattern</b>
  Orange: Facade · Green: Command
  Blue: Observer
  Each view sends user actions to the
  controller with the matching name
  (AgendaView → AgendaController, …;
  VenueView/DashboardView → EventController).
  The facade's collaborators in the agent and
  domain layers are shown in CD0 and CD2–CD4.
endlegend
@enduml
