@startuml ST_event_lifecycle
!include style.iuml
title Event Lifecycle — implemented with the State pattern\n<size:13><i>Each box is one EventState class. Arrows are LifecycleActions; [text] is the guard that must be true.</i></size>
skinparam state {
  BackgroundColor #FCE4EC
  BorderColor #AD1457
  FontStyle bold
}
[*] --> Draft : event created (F01)
state "Draft\n(DraftState)" as Draft : can edit plan\ncannot send invitations
state "Planning\n(PlanningState)" as Planning : can edit plan\ncan send invitations
state "Confirmed\n(ConfirmedState)" as Confirmed : can edit (with warnings)\ncan send invitations
state "Completed\n(CompletedState)" as Completed : read-only
state "Cancelled\n(CancelledState)" as Cancelled : read-only
Draft --> Planning : START_PLANNING\n[name, date and attendance set]
Planning --> Confirmed : CONFIRM\n[venue chosen, agenda not empty,\nno HIGH conflicts, within budget]
Confirmed --> Planning : REOPEN
Confirmed --> Completed : COMPLETE\n[event date has passed]
Draft --> Cancelled : CANCEL
Planning --> Cancelled : CANCEL
Confirmed --> Cancelled : CANCEL
Completed --> [*]
Cancelled --> [*]
@enduml
