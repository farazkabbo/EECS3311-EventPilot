@startuml CD3_domain_model
!include style.iuml
hide empty members
title CD3 — Domain Model: the Event and its parts\n<size:13><i>Event is the centre of the model. Its lifecycle rules live in EventState objects (State pattern).</i></size>

package "Domain: the event and its parts" #FBF7FF {
  class Event <<Context>> {
    - id : UUID
    - name : String
    - type : EventType
    - startDateTime : LocalDateTime
    - endDateTime : LocalDateTime
    - expectedAttendance : int
    - city : String
    - state : EventState
    + transition(a : LifecycleAction) : EventState
    + ensureEditable() : void
    + ensureCanInvite() : void
    + setState(s : EventState) : void
    + getAgenda() : Agenda
    + getBudget() : Budget
    + getVenue() : Venue
    + confirmedAttendees() : List<Attendee>
    + deepCopy() : Event
  }

  interface EventState <<State>> {
    + name() : String
    + ensureEditable(e : Event) : void
    + ensureCanInvite(e : Event) : void
    + onAction(e : Event, a : LifecycleAction) : EventState
  }
  class DraftState <<State>>
  class PlanningState <<State>>
  class ConfirmedState <<State>>
  class CompletedState <<State>>
  class CancelledState <<State>>

  class Agenda {
    - items : List<AgendaItem>
    + add(i : AgendaItem) : void
    + remove(id : UUID) : AgendaItem
    + findById(id : UUID) : AgendaItem
    + sessions() : List<SessionItem>
  }
  abstract class AgendaItem {
    # id : UUID
    # title : String
    # start : LocalDateTime
    # end : LocalDateTime
    # room : String
    + overlaps(o : AgendaItem) : boolean
  }
  class SessionItem {
    - speakerId : UUID
    - capacity : int
    - track : String
    + assignSpeaker(id : UUID) : void
    + reschedule(s : LocalDateTime, e : LocalDateTime) : void
  }
  class BreakItem {
    - isMeal : boolean
  }

  class Attendee {
    - name : String
    - email : String
    - role : AttendeeRole
    - rsvpStatus : RsvpStatus
    - dietaryRestrictions : Set<Diet>
    + updateRsvp(s : RsvpStatus) : void
  }
  class Speaker {
    - name : String
    - topic : String
    - availability : List<TimeWindow>
    + isAvailable(w : TimeWindow) : boolean
  }
  class Venue {
    - name : String
    - capacity : int
    - pricePerDay : Money
    - amenities : Set<String>
    - accessible : boolean
  }
  class Budget {
    - limit : Money
    - lines : List<BudgetLine>
    - expenses : List<Expense>
    + totalPlanned() : Money
    + totalSpent() : Money
    + remaining() : Money
    + isOverBudget() : boolean
  }
  class BudgetLine {
    - category : BudgetCategory
    - planned : Money
    - spent : Money
    + utilization() : double
  }
  class Expense {
    - category : BudgetCategory
    - amount : Money
    - date : LocalDate
  }
  class CateringPlan {
    - headcount : int
    - dietarySummary : Map<Diet,Integer>
    - meals : List<MealService>
    - estimatedCost : Money
  }
  class EventTask {
    - title : String
    - owner : String
    - dueDate : LocalDate
    - status : TaskStatus
    - dependencies : List<UUID>
    + isOverdue(today : LocalDate) : boolean
  }
  class Invitation {
    - attendeeId : UUID
    - subject : String
    - body : String
    - tone : Tone
    - status : DeliveryStatus
  }

  Event o-right-> "1" EventState : current state
  EventState <|.. DraftState
  EventState <|.. PlanningState
  EventState <|.. ConfirmedState
  EventState <|.. CompletedState
  EventState <|.. CancelledState

  Event *-- "1" Agenda
  Agenda o-- "0..*" AgendaItem
  AgendaItem <|-- SessionItem
  AgendaItem <|-- BreakItem
  Event *-- "0..*" Attendee
  Event *-- "0..*" Speaker
  Event o-- "0..1" Venue : selected
  Event *-- "1" Budget
  Budget *-- "0..*" BudgetLine
  Budget *-- "0..*" Expense
  Event *-- "0..1" CateringPlan
  Event *-- "0..*" EventTask
  Event *-- "0..*" Invitation
}

legend right
  <b>How to read</b>
  ◆— composition (part is owned)
  ◇— aggregation (part is shared / replaceable)
  ▷ inheritance, ⇢ dependency
  Pink = State pattern
endlegend
@enduml
