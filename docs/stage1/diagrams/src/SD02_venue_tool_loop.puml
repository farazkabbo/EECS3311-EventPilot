@startuml SD02_venue_tool_loop
!include style.iuml
hide footbox
autonumber "<b>[0]"
title SD02 — Venue recommendation: how the agent uses tools (F03, UC03)\n<size:13><i>This "think → call tool → observe" loop is the same for every AI feature.</i></size>

actor Organizer
box "GUI" #EEF5FD
  participant ":EventController" as EC
end box
box "Application" #FFF8F0
  participant ":EventPlannerFacade" as F
end box
box "Agent" #FFFDE7
  participant ":VenueRecommendation\nWorkflow" as WF
  participant ":AgentOrchestrator" as ORC
  participant ":LLMClient" as LLM
  participant ":ClaudeProvider" as CP
  participant ":ToolRegistry" as TR
  participant ":VenueSearchTool" as VST
end box
box "Infrastructure" #ECEFF1
  participant ":JsonVenueCatalog\nAdapter" as CAT
end box
participant "Claude API\n(external LLM)" as API #F3E5F5

Organizer -> EC : clicks "Recommend venues"
EC -> F : recommendVenues(eventId)
activate F
F -> F : event.ensureEditable()
note right of F : the Event's current state decides;\nCompleted / Cancelled events refuse
F -> WF : execute(event, input)
activate WF
WF -> ORC : run(task)\nallowed tools: venue_search, budget_calculator
activate ORC

loop until the LLM gives a final answer (max 8 steps)
  ORC -> LLM : complete(request)
  LLM -> CP : chat(request)
  CP -> API : HTTPS POST /v1/messages
  API --> CP : JSON reply
  CP --> LLM : LLMResponse
  LLM --> ORC : LLMResponse
  alt the LLM asks to call a tool
    ORC -> TR : execute(venue_search {capacity ≥ 120, city: Toronto})
    TR -> TR : check arguments against the tool's schema
    alt arguments invalid
      TR --> ORC : ToolResult.error("capacity must be > 0")
      note right of ORC : the tool is NOT run; the error is\nsent back to the LLM to correct itself
    else arguments valid
      TR -> VST : execute(args)
      VST -> CAT : search(criteria)
      CAT --> VST : List<Venue>
      VST --> TR : ToolResult(venues)
      TR --> ORC : ToolResult
    end
  else the LLM gives its final answer
    ORC -> ORC : stop loop
  end
end
ORC --> WF : AgentRunResult(answer, toolTrace)
deactivate ORC

WF -> WF : createParser().parse(raw)\n→ PlanProposal with up to 3 SetVenueCommands
WF -> WF : validate(): capacity, budget, and every\nvenue must come from the tool results
WF --> F : WorkflowOutcome<PlanProposal>
deactivate WF
F --> EC : PlanProposal (3 ranked venues + reasons)
deactivate F
ref over EC, F : Organizer picks one venue → review & apply (see SD03)

opt step limit reached / no venue found
  F --> EC : proposal with a warning: "refine your criteria"
end
@enduml
