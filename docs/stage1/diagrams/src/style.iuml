' Shared style — EventPilot Stage 1 (lean, readability-first)
skinparam dpi 140
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam classAttributeIconSize 0
skinparam roundcorner 8
skinparam ArrowColor #455A64
skinparam ArrowFontSize 11
skinparam ArrowFontColor #37474F
skinparam ArrowThickness 1.2
skinparam nodesep 40
skinparam ranksep 50
skinparam padding 2

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #546E7A
  HeaderBackgroundColor #ECEFF1
  StereotypeFontSize 11
  StereotypeFontColor #AD1457
  FontStyle bold
  AttributeFontSize 12
}
' pattern colours (same colour = same pattern everywhere)
skinparam class {
  BackgroundColor<<Facade>> #FFF3E0
  BackgroundColor<<Command>> #E8F5E9
  BackgroundColor<<Invoker>> #E8F5E9
  BackgroundColor<<Subject>> #E3F2FD
  BackgroundColor<<Observer>> #E3F2FD
  BackgroundColor<<Strategy>> #F3E5F5
  BackgroundColor<<Context>> #F3E5F5
  BackgroundColor<<Template Method>> #FFFDE7
  BackgroundColor<<State>> #FCE4EC
  BackgroundColor<<Adapter>> #E0F7FA
  BackgroundColor<<Adaptee>> #E0F7FA
  BackgroundColor<<Target>> #E0F7FA
}
skinparam package {
  BorderColor #90A4AE
  BackgroundColor #FCFCFC
  FontStyle bold
  FontSize 14
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
  FontSize 12
}
skinparam legend {
  BackgroundColor #FAFAFA
  BorderColor #B0BEC5
  FontSize 12
}

' sequence diagrams
skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #546E7A
  ParticipantFontStyle bold
  ActorBorderColor #546E7A
  ActorBackgroundColor #FFFFFF
  LifeLineBorderColor #B0BEC5
  LifeLineBackgroundColor #ECEFF1
  GroupBorderColor #78909C
  GroupBackgroundColor #ECEFF1
  GroupHeaderFontStyle bold
  BoxBorderColor #CFD8DC
  BoxFontStyle bold
  DividerBackgroundColor #455A64
  DividerFontColor #FFFFFF
  DividerFontStyle bold
}
skinparam maxMessageSize 220
skinparam ParticipantPadding 12
skinparam BoxPadding 8
skinparam responseMessageBelowArrow true

skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontSize 13
}
skinparam actor {
  BorderColor #37474F
  FontStyle bold
}
skinparam rectangle {
  BorderColor #90A4AE
  FontStyle bold
}
