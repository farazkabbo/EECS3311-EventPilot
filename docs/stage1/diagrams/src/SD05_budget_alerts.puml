@startuml SD05_budget_alerts
!include style.iuml
hide footbox
autonumber "<b>[0]"
title SD05 — Plan the budget, record expenses, raise alerts (F07, UC07)

actor Organizer
box "GUI" #EEF5FD
  participant ":BudgetController" as BC
  participant ":DashboardView" as DV
end box
box "Application" #FFF8F0
  participant ":EventPlannerFacade" as F
  participant ":EventBus" as BUS
  participant ":AlertService" as AS
end box
box "Agent" #FFFDE7
  participant ":BudgetPlanning\nWorkflow" as WF
  participant ":BudgetCalculatorTool" as BCT
end box
box "Domain" #FBF7FF
  participant ":BudgetTracker" as BT
end box

== AI budget plan ==
Organizer -> BC : clicks "Generate budget plan"
BC -> F : generateBudget(eventId)
activate F
F -> WF : execute(event, input)
activate WF
WF -> BCT : (via agent loop) execute(allocate, limit $5000,\nweights VENUE 35%, CATERING 30% …)
BCT -> BT : allocate(limit, weights)
BT --> BCT : budget lines (exact money math)
BCT --> WF : ToolResult
note right of WF : the LLM only chooses the split and\nexplains it — it never does arithmetic
WF -> WF : validate(): total ≤ limit
WF --> F : PlanProposal (SetBudgetLineCommand × n)
deactivate WF
F --> BC : PlanProposal → review & apply (SD03)
deactivate F

== Record an expense (no AI) ==
Organizer -> BC : enters "Catering $1,850 deposit"
BC -> BC : onRecordExpense(form): amount > 0? category set?
alt form invalid
  BC -> Organizer : show field errors
else form valid
  BC -> F : recordExpense(eventId, expense)
  activate F
  F -> BT : recordExpense(budget, expense)
  BT --> F : BudgetStatus
  F -> F : repository.save(event)
  F -> BUS : publish(BUDGET_CHANGED)
  BUS -> AS : onEventChanged(d)
  AS -> BT : computeStatus(budget)
  BT --> AS : BudgetStatus
  opt a category is over plan or total ≥ 90 %
    AS -> BUS : publish(ALERT_RAISED)
    BUS -> DV : onEventChanged(d) → alert banner
  end
  F --> BC : BudgetStatus
  deactivate F
end
@enduml
