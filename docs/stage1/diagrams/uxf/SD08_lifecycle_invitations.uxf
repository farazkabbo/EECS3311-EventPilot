<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <element>
    <id>UMLSequenceAllInOne</id>
    <coordinates>
      <x>0</x>
      <y>0</y>
      <w>1330</w>
      <h>2370</h>
    </coordinates>
    <panel_attributes>title=SD08 — Change the event state, then send invitations — the State pattern at run time (UC15, F10, UC10)
autoTick=true
obj=Organizer~organizer ACTOR
obj=:EventController /\n:AttendeeController~c
obj=:EventPlannerFacade~f
obj=event:Event~ev
obj=state:EventState~st
obj=:InvitationDrafting\nWorkflow~wf
obj=:OutboxFileGateway~gw

continuation=organizer gw :UC15 — confirm the event
organizer-&gt;&gt;&gt;c :1. clicks "Confirm event"
c-&gt;&gt;&gt;f :2. transitionEvent(eventId,\nCONFIRM); on=f
f-&gt;&gt;&gt;f + :3.\nconflictDetec\ntor.detect(\nevent),\nbudgetTracker\n.computeStatu\ns(budget)
tick=
combinedFragment=alt~f1 c st
c:[HIGH conflicts\nor over budget]
f.&gt;c :4. refused with reasons
..=f1
f-&gt;&gt;&gt;ev :5. transition(CONFIRM)
ev-&gt;&gt;&gt;st :6. onAction(event, CONFIRM)
st-&gt;&gt;&gt;ev :7. setState(new\nConfirmedState())
f-&gt;&gt;&gt;f + :8. save,\npublish(\nSTATE_\nCHANGED)
tick=
f.&gt;c :9. ConfirmedState
--=f1
off=f
continuation=organizer gw :F10 — draft and send invitations
organizer-&gt;&gt;&gt;c :10. picks tone "Friendly",\nclicks "Draft invitations"
c-&gt;&gt;&gt;f :11. draftInvitations(eventId,\nFRIENDLY); on=f
f-&gt;&gt;&gt;ev :12. ensureCanInvite()
ev-&gt;&gt;&gt;st :13. ensureCanInvite(event)
combinedFragment=alt~f2 organizer gw
organizer:[state is Draft,\nCompleted or\nCancelled]
st.&gt;f :14. refused: "start planning\nfirst"
..=f2
organizer:[Planning or\nConfirmed]
f-&gt;&gt;&gt;wf :15. execute(event, tone)
wf-&gt;&gt;&gt;wf + :16. one\ntemplate per\ngroup\n(speakers,\nVIPs,\nguests),\ncheck each\nhas the real\ndate, time,\nvenue
tick=
wf.&gt;f :17. List&lt;Invitation&gt;
f.&gt;c :18. drafts (Organizer may\nedit)
organizer-&gt;&gt;&gt;c :19. clicks "Send"
c-&gt;&gt;&gt;f :20. sendInvitations(eventId,\ndrafts)
combinedFragment=loop~f3 f gw
f:[each attendee]
f-&gt;&gt;&gt;gw :21. send(invitation)
gw.&gt;f :22. SENT or FAILED (failures\nare listed, not fatal)
--=f3
f.&gt;c :23. DeliveryReport (117 sent,\n1 failed)
--=f2
off=f
fontsize=13</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
