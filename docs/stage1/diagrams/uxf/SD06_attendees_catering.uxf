    <panel_attributes>title=SD06 — Import attendees, update RSVPs, then plan catering (F02, F08, UC02, UC08)
autoTick=true
obj=Organizer~organizer ACTOR
obj=:AttendeeController~ac
obj=:EventPlannerFacade~f
obj=:EventBus~bus
obj=:CateringPlanning\nWorkflow~wf
obj=:GuardrailValidator~gv
obj=:CateringCalculator~cc
obj=:AttendeeCsvImporter~imp

continuation=organizer imp :F02 — import attendees (no AI)
organizer-&gt;&gt;&gt;ac :1. chooses attendees.csv
ac-&gt;&gt;&gt;f :2. importAttendees(eventId,\npath); on=f
f-&gt;&gt;&gt;imp :3. parse(path)
combinedFragment=alt~f1 ac imp
ac:[file missing or\nwrong header]
imp.&gt;f :4. error → shown to Organizer
..=f1
imp.&gt;f :5. ImportReport (imported,\nrejected rows, duplicates)
f-&gt;&gt;&gt;f + :6. add\nattendees,\nrepository.\nsave(event)
tick=
f-&gt;&gt;&gt;bus :7. publish(ATTENDEES_CHANGED)
f.&gt;ac :8. "118 imported, 2 rejected\n(line 14: bad e-mail)"
--=f1
off=f
organizer-&gt;&gt;&gt;ac :9. sets Ana's RSVP to ACCEPTED
ac-&gt;&gt;&gt;f :10. updateRsvp(eventId,\nattendeeId, ACCEPTED)
f-&gt;&gt;&gt;f + :11. attendee.\nupdateRsvp(\nACCEPTED),\nsave, publish
tick=
continuation=organizer imp :F08 — AI catering plan
organizer-&gt;&gt;&gt;ac :12. clicks "Plan catering"
ac-&gt;&gt;&gt;f :13. planCatering(eventId); on=f
f-&gt;&gt;&gt;wf :14. execute(event, input); on=wf
wf-&gt;&gt;&gt;cc :15. computeHeadcount(confirmed\nattendees)
cc.&gt;wf :16. 96
wf-&gt;&gt;&gt;cc :17. summarizeDiets(attendees)
cc.&gt;wf :18. vegetarian 18, vegan 6,\nhalal 9, nut allergy 2
wf-&gt;&gt;&gt;wf + :19. agent\nloop → menu +\nmeal times +\nportions
tick=
wf-&gt;&gt;&gt;gv :20. validateProposal(proposal,\nevent)
gv.&gt;wf :21. every diet covered? cost ≤\ncatering budget?
wf.&gt;f :22. PlanProposal\n(SetCateringPlanCommand); off=wf
f.&gt;ac :23. PlanProposal → review &amp;\napply (SD03); off=f
fontsize=13</panel_attributes>
