<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <element>
    <id>UMLSequenceAllInOne</id>
    <coordinates>
      <x>0</x>
      <y>0</y>
      <w>1330</w>
      <h>2210</h>
    </coordinates>
    <panel_attributes>title=SD04 — Schedule speakers, then detect and resolve conflicts (F05, F06, UC05, UC06)
autoTick=true
obj=Organizer~organizer ACTOR
obj=:AgendaController~ac
obj=:EventPlannerFacade~f
obj=:SpeakerScheduling\nWorkflow~swf
obj=:ConflictResolution\nWorkflow~cwf
obj=:ToolRegistry~tr
obj=:ConflictDetector~cd

continuation=organizer cd :F05 — AI speaker scheduling
organizer-&gt;&gt;&gt;ac :1. clicks "Auto-schedule\nspeakers"
ac-&gt;&gt;&gt;ac + :2.\nonScheduleSpe\nakers()
tick=
ac-&gt;&gt;&gt;f :3. scheduleSpeakers(eventId); on=f
combinedFragment=alt~f1 ac cd
ac:[no speakers or\nno sessions yet]
f.&gt;ac :4. error "add speakers and\nsessions first"
..=f1
f-&gt;&gt;&gt;swf :5. execute(event, input); on=swf
swf-&gt;&gt;&gt;tr :6.\nexecute(speaker_availability)
tr.&gt;swf :7. availability windows
swf-&gt;&gt;&gt;tr :8. execute(conflict_check\n{draft assignments})
tr-&gt;&gt;&gt;cd :9. detect(copy of event)
cd.&gt;tr :10. conflicts
tr.&gt;swf :11. ToolResult
swf.&gt;f :12. PlanProposal\n(AssignSpeakerCommand,\nMoveSessionCommand); off=swf
f.&gt;ac :13. PlanProposal → review &amp;\napply (SD03)
--=f1
off=f
continuation=organizer cd :F06 — conflict detection (no AI)
organizer-&gt;&gt;&gt;ac :14. clicks "Check conflicts"
ac-&gt;&gt;&gt;f :15. detectConflicts(eventId); on=f
f-&gt;&gt;&gt;cd :16. detect(event)
cd.&gt;f :17. List&lt;Conflict&gt;
f.&gt;ac :18. conflicts (highlighted in\nred); off=f
continuation=organizer cd :F06 — AI conflict resolution
combinedFragment=opt~f2 ac cd
ac:[conflicts found\nand Organizer\nclicks "Ask\nagent to fix"]
ac-&gt;&gt;&gt;f :19. resolveConflicts(eventId,\nconflicts); on=f
f-&gt;&gt;&gt;cwf :20. execute(event, conflicts); on=cwf
cwf-&gt;&gt;&gt;cwf + :21. agent\nproposes\nmoves /\nreassignments
tick=
cwf-&gt;&gt;&gt;cd :22. detect(event.deepCopy()\nwith the fix applied)
cd.&gt;cwf :23. remaining conflicts
combinedFragment=alt~f3 cwf cwf
cwf:[the fix creates\nnew conflicts]
cwf-&gt;&gt;&gt;cwf + :24. mark\nproposal as\nblocked,\nretry once
tick=
--=f3
cwf.&gt;f :25. PlanProposal; off=cwf
f.&gt;ac :26. PlanProposal → review &amp;\napply (SD03); off=f
--=f2
fontsize=13</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
</diagram>
