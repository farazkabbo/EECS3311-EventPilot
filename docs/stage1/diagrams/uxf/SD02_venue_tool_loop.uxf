    <panel_attributes>title=SD02 — Venue recommendation: how the agent uses tools (F03, UC03) — This "think → call tool → observe" loop is the same for every AI feature.
autoTick=true
obj=Organizer~organizer ACTOR
obj=:EventController~ec
obj=:EventPlannerFacade~f
obj=:VenueRecommendation\nWorkflow~wf
obj=:AgentOrchestrator~orc
obj=:LLMClient~llm
obj=:ClaudeProvider~cp
obj=:ToolRegistry~tr
obj=:VenueSearchTool~vst
obj=:JsonVenueCatalog\nAdapter~cat
obj=Claude API\n(external LLM)~api

organizer-&gt;&gt;&gt;ec :1. clicks "Recommend venues"
ec-&gt;&gt;&gt;f :2. recommendVenues(eventId); on=f
f-&gt;&gt;&gt;f + :3. event.\nensureEditabl\ne()
tick=
f-&gt;&gt;&gt;wf :4. execute(event, input); on=wf
wf-&gt;&gt;&gt;orc :5. run(task) allowed tools:\nvenue_search,\nbudget_calculator; on=orc
combinedFragment=loop~f1 orc api
orc:[until the LLM\ngives a final\nanswer (max 8\nsteps)]
orc-&gt;&gt;&gt;llm :6. complete(request)
llm-&gt;&gt;&gt;cp :7. chat(request)
cp-&gt;&gt;&gt;api :8. HTTPS POST /v1/messages
api.&gt;cp :9. JSON reply
cp.&gt;llm :10. LLMResponse
llm.&gt;orc :11. LLMResponse
combinedFragment=alt~f2 orc cat
orc:[the LLM asks to\ncall a tool]
orc-&gt;&gt;&gt;tr :12. execute(venue_search\n{capacity ≥ 120, city:\nToronto})
tr-&gt;&gt;&gt;tr + :13. check\narguments\nagainst the\ntool's schema
tick=
combinedFragment=alt~f3 orc cat
orc:[arguments\ninvalid]
tr.&gt;orc :14. ToolResult.error("capacity\nmust be &gt; 0")
..=f3
orc:[arguments valid]
tr-&gt;&gt;&gt;vst :15. execute(args)
vst-&gt;&gt;&gt;cat :16. search(criteria)
cat.&gt;vst :17. List&lt;Venue&gt;
vst.&gt;tr :18. ToolResult(venues)
tr.&gt;orc :19. ToolResult
--=f3
..=f2
orc:[the LLM gives\nits final\nanswer]
orc-&gt;&gt;&gt;orc + :20. stop loop
tick=
--=f2
--=f1
orc.&gt;wf :21. AgentRunResult(answer,\ntoolTrace); off=orc
wf-&gt;&gt;&gt;wf + :22.\ncreateParser(\n).parse(raw)\n→\nPlanProposal\nwith up to 3\nSetVenueComma\nnds
tick=
wf-&gt;&gt;&gt;wf + :23.\nvalidate():\ncapacity,\nbudget, and\nevery venue\nmust come\nfrom the tool\nresults
tick=
wf.&gt;f :24.\nWorkflowOutcome&lt;PlanProposal&gt;; off=wf
f.&gt;ec :25. PlanProposal (3 ranked\nvenues + reasons); off=f
ref=ec f :Organizer picks one venue → review &amp; apply (see SD03)
tick=
combinedFragment=opt~f4 ec f
ec:[step limit\nreached / no\nvenue found]
f.&gt;ec :26. proposal with a warning:\n"refine your criteria"
--=f4
fontsize=13</panel_attributes>
